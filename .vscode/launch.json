{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Debugs whichever sample .ts file is open in the editor.
            // Node 24 runs TypeScript directly (type stripping), so no build step is needed.
            "name": "Debug current sample file",
            "type": "node",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            // Let Node load .env itself. VS Code's "envFile" would put every
            // secret into the command line it types into the terminal.
            "runtimeArgs": [
                "--env-file=${workspaceFolder}/.env"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}

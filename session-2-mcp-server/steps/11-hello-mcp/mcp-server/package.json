{
  "name": "practice-jazz-chords-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Practice Jazz Chords",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",

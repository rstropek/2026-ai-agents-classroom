{
  "name": "jazz-chord-flashcards-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@mcpjam/cli": "^6.4.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc -p .",
    "format": "biome check --write .",
    "doctor": "mcpjam --no-telemetry server doctor --transport stdio --command node --args src/main.ts"
  }
